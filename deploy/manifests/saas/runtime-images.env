# Immutable training-runtime images, owned by Git and reconciled by ArgoCD.
#
# These are NOT secrets: they are the job images the backend launches. Each must
# stay an immutable `sb3-<git-sha>` / `mjx-<git-sha>` tag or a digest — the
# backend refuses mutable tags at startup (saas/backend/app/settings.py).
#
# Every main push publishes an immutable runtime, but nothing repoints this file
# automatically. To promote one, dispatch the training-runtime-images workflow on
# the merged commit with `promote: true` — that rerun is where the frozen cpu-d3
# profile gates get exercised before tenants see the build. Hand edits are for
# rollback.
#
# `saas-nebius` (written by cloud-init from OpenTofu) still carries these three
# keys, but the Deployment's explicit `env:` entries take precedence over
# `envFrom:`, so this file wins.
SIM2POLICY_JOB_IMAGE=cr.eu-north1.nebius.cloud/e00gkhk5kcqp6fej6g/sim2policy:sb3-5fd882b1548a7f7a3475db1cc1ec8c7f90fa1995
CUSTOM_ROBOT_SB3_IMAGE=cr.eu-north1.nebius.cloud/e00gkhk5kcqp6fej6g/sim2policy:sb3-5fd882b1548a7f7a3475db1cc1ec8c7f90fa1995
SIM2POLICY_MJX_JOB_IMAGE=cr.eu-north1.nebius.cloud/e00gkhk5kcqp6fej6g/sim2policy:mjx-ce4ad5a0a2e957020f74dd208f71eb21135f4a9c
