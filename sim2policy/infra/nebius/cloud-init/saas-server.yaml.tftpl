#cloud-config
# Bootstraps the saas-server: k3s (single node) + ArgoCD, credentials from MysteryBox.
# k3s API (6443) and ArgoCD stay private; reach them via `ssh -L` (see design.md Decision 6).
users:
  - name: saas-server
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
packages:
  - curl
  - jq
  - ufw

write_files:
  - path: /opt/saas/sync-nebius-secret.sh
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

      ARTIFACT_SELECTOR="${artifact_selector}"
      REGISTRY_SELECTOR="${registry_secret_selector}"
      TMP_FILE="$(mktemp /run/saas-nebius.XXXXXX.json)"
      chmod 0600 "$TMP_FILE"
      cleanup() { rm -f "$TMP_FILE"; }
      trap cleanup EXIT HUP INT TERM

      fetch_selector_key() {
        local selector="$1" key="$2" secret_id version_id
        secret_id="$(printf '%s' "$selector" | cut -d/ -f1)"
        version_id="$(printf '%s' "$selector" | cut -s -d/ -f2)"
        if [ -z "$secret_id" ] || [ -z "$version_id" ]; then
          echo "[saas-nebius-sync] ERROR: selector must include secret and version IDs" >&2
          return 1
        fi
        nebius mysterybox payload get --secret-id "$secret_id" --version-id "$version_id" --format json 2>/dev/null \
          | jq -er --arg k "$key" '.data[] | select(.key==$k) | .string_value // .value'
      }

      AWS_SECRET_ACCESS_KEY="$(fetch_selector_key "$ARTIFACT_SELECTOR" secret)"
      if [ -z "$AWS_SECRET_ACCESS_KEY" ]; then
        echo "[saas-nebius-sync] ERROR: artifact secret payload is empty" >&2
        exit 1
      fi

      kubectl create namespace saas --dry-run=client -o yaml | kubectl apply -f - >/dev/null
      cat >"$TMP_FILE" <<EOF
      {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": "saas-nebius", "namespace": "saas"},
        "type": "Opaque",
        "stringData": {
          "SAAS_ORCHESTRATION_BACKEND": "nebius",
          "NEBIUS_PROJECT_ID": "${project_id}",
          "NEBIUS_SUBNET_ID": "${subnet_id}",
          "SIM2POLICY_JOB_IMAGE": "${job_image}",
          "SIM2POLICY_MJX_JOB_IMAGE": "${mjx_job_image}",
          "NEBIUS_S3_SECRET_SELECTOR": "${artifact_selector}",
          "NEBIUS_REGISTRY_SECRET": "${registry_secret_version_id}",
          "AWS_ACCESS_KEY_ID": "${artifact_access_key_id}",
          "AWS_SECRET_ACCESS_KEY": "$AWS_SECRET_ACCESS_KEY",
          "AWS_ENDPOINT_URL_S3": "https://storage.eu-north1.nebius.cloud",
          "AWS_DEFAULT_REGION": "eu-north1",
          "SIM2POLICY_S3_BUCKET": "${artifact_bucket}"
        }
      }
      EOF
      kubectl apply -f "$TMP_FILE" >/dev/null
      echo "[saas-nebius-sync] reconciled namespace/name and expected keys (values suppressed)"

  - path: /etc/systemd/system/saas-nebius-sync.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Reconcile the SaaS Nebius orchestration secret from MysteryBox
      After=k3s.service network-online.target
      Wants=network-online.target
      Requires=k3s.service

      [Service]
      Type=oneshot
      ExecStart=/opt/saas/sync-nebius-secret.sh
      User=root
      Group=root
      UMask=0077

      [Install]
      WantedBy=multi-user.target

  - path: /opt/saas/sync-smtp-secret.sh
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

      SMTP_SELECTOR="${smtp_secret_selector}"
      ALLOWED_KEYS='["SAAS_SMTP_HOST","SAAS_SMTP_PORT","SAAS_SMTP_USER","SAAS_SMTP_PASSWORD","SAAS_SMTP_FROM","SAAS_SMTP_TLS_MODE","SAAS_SMTP_TIMEOUT_SECONDS"]'
      PAYLOAD_FILE="$(mktemp /run/saas-smtp-payload.XXXXXX.json)"
      SECRET_FILE="$(mktemp /run/saas-smtp-secret.XXXXXX.json)"
      chmod 0600 "$PAYLOAD_FILE" "$SECRET_FILE"
      cleanup() { rm -f "$PAYLOAD_FILE" "$SECRET_FILE"; }
      trap cleanup EXIT HUP INT TERM

      secret_id="$(printf '%s' "$SMTP_SELECTOR" | cut -d/ -f1)"
      version_id="$(printf '%s' "$SMTP_SELECTOR" | cut -s -d/ -f2)"
      if [ -z "$secret_id" ] || [ -z "$version_id" ]; then
        echo "[saas-smtp-sync] ERROR: selector must include secret and version IDs" >&2
        exit 1
      fi

      nebius mysterybox payload get \
        --secret-id "$secret_id" --version-id "$version_id" --format json \
        >"$PAYLOAD_FILE" 2>/dev/null

      if ! jq -e --argjson allowed "$ALLOWED_KEYS" '
        (.data | map(.key) | sort) == ($allowed | sort) and
        all(.data[]; ((.string_value // .value // "") | length) > 0)
      ' "$PAYLOAD_FILE" >/dev/null; then
        echo "[saas-smtp-sync] ERROR: payload must contain exactly seven non-empty expected keys" >&2
        exit 1
      fi

      jq --argjson allowed "$ALLOWED_KEYS" '
        {
          apiVersion: "v1",
          kind: "Secret",
          metadata: {name: "saas-smtp", namespace: "saas"},
          type: "Opaque",
          stringData: (
            .data
            | map(select(.key as $key | $allowed | index($key)))
            | map({key: .key, value: (.string_value // .value)})
            | from_entries
          )
        }
      ' "$PAYLOAD_FILE" >"$SECRET_FILE"

      kubectl create namespace saas --dry-run=client -o yaml | kubectl apply -f - >/dev/null
      kubectl apply -f "$SECRET_FILE" >/dev/null
      echo "[saas-smtp-sync] reconciled saas/saas-smtp with seven expected keys (values suppressed)"

  - path: /etc/systemd/system/saas-smtp-sync.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Reconcile the SaaS SMTP secret from MysteryBox
      After=k3s.service network-online.target
      Wants=network-online.target
      Requires=k3s.service

      [Service]
      Type=oneshot
      ExecStart=/opt/saas/sync-smtp-secret.sh
      User=root
      Group=root
      UMask=0077

      [Install]
      WantedBy=multi-user.target

  # Idempotent bootstrap. Logs to /var/log/saas-bootstrap.log for debugging.
  - path: /opt/saas/bootstrap.sh
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      exec > >(tee -a /var/log/saas-bootstrap.log) 2>&1
      echo "[bootstrap] $(date -u) starting"

      GITHUB_SECRET_ID="${github_secret_id}"
      REGISTRY_SECRET_ID="${registry_secret_id}"
      REGISTRY_HOST="${registry_host}"
      USE_REGISTRY_PULL="${use_registry_pull}"
      ARGOCD_REPO_URL="${argocd_repo_url}"
      ARGOCD_REPO_PATH="${argocd_repo_path}"
      ARGOCD_REPO_REVISION="${argocd_repo_revision}"
      SMTP_SECRET_SELECTOR="${smtp_secret_selector}"

      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

      # --- Host firewall (defense-in-depth; Nebius security group is the primary control) ---
      # Only 22/80/443 inbound. Allow k3s pod/service CIDRs so cluster networking works.
      ufw --force reset
      ufw default deny incoming
      ufw default allow outgoing
      ufw allow 22/tcp
      ufw allow 80/tcp
      ufw allow 443/tcp
      ufw allow from 10.42.0.0/16   # k3s pod CIDR
      ufw allow from 10.43.0.0/16   # k3s service CIDR
      ufw --force enable

      # --- k3s (idempotent: installer is safe to re-run) ---
      if ! command -v k3s >/dev/null 2>&1; then
        # --tls-san localhost lets a tunneled kubectl (ssh -L 6443) verify the API cert.
        curl -sfL https://get.k3s.io | \
          INSTALL_K3S_EXEC="server --tls-san localhost --write-kubeconfig-mode 0640" sh -
      fi

      echo "[bootstrap] waiting for node Ready"
      for i in $(seq 1 60); do
        if kubectl get nodes 2>/dev/null | grep -q " Ready"; then break; fi
        sleep 5
      done
      kubectl get nodes

      systemctl daemon-reload
      systemctl enable saas-nebius-sync.service
      systemctl enable saas-smtp-sync.service

      # --- Fetch secrets from MysteryBox using the VM service-account identity ---
      # The primary secret version is selected when --version-id is omitted.
      if ! command -v nebius >/dev/null 2>&1; then
        curl -sSL https://storage.eu-north1.nebius.cloud/nebius-cli/install.sh | bash || true
        export PATH="$PATH:/root/.nebius/bin:/usr/local/bin"
      fi
      fetch_secret_key() {
        local secret_id="$1" key="$2"
        nebius mysterybox payload get --secret-id "$secret_id" --format json \
          | jq -r --arg k "$key" '.data[] | select(.key==$k) | .string_value // .value'
      }

      GITHUB_TOKEN="$(fetch_secret_key "$GITHUB_SECRET_ID" token)"
      if [ -z "$GITHUB_TOKEN" ] || [ "$GITHUB_TOKEN" = "null" ]; then
        echo "[bootstrap] ERROR: could not read GitHub token from MysteryBox" >&2
        exit 1
      fi

      # --- ArgoCD (private ClusterIP; access via ssh -L to the argocd-server service) ---
      kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
      kubectl apply --server-side --force-conflicts -n argocd \
        -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml
      kubectl -n argocd rollout status deploy/argocd-server --timeout=300s || true

      # ArgoCD repository credential (private repo read) from the GitHub token.
      kubectl -n argocd apply -f - <<EOF
      apiVersion: v1
      kind: Secret
      metadata:
        name: saas-repo
        namespace: argocd
        labels:
          argocd.argoproj.io/secret-type: repository
      stringData:
        type: git
        url: $ARGOCD_REPO_URL
        password: $GITHUB_TOKEN
        username: git
      EOF

      # Optional registry imagePullSecret (only when node-identity pull is insufficient).
      if [ "$USE_REGISTRY_PULL" = "true" ] && [ -n "$REGISTRY_SECRET_ID" ]; then
        REG_PASS="$(fetch_secret_key "$REGISTRY_SECRET_ID" token)"
        kubectl create namespace saas --dry-run=client -o yaml | kubectl apply -f -
        kubectl -n saas create secret docker-registry nebius-registry \
          --docker-server="$REGISTRY_HOST" --docker-username=iam \
          --docker-password="$REG_PASS" --dry-run=client -o yaml | kubectl apply -f -
        kubectl -n saas patch serviceaccount default --type merge \
          -p '{"imagePullSecrets":[{"name":"nebius-registry"}]}'
      fi

      # Resolve the versioned artifact credential with this VM's attached
      # orchestrator identity and reconcile the backend environment contract.
      systemctl start saas-nebius-sync.service
      if [ -n "$SMTP_SECRET_SELECTOR" ]; then
        systemctl start saas-smtp-sync.service
      else
        echo "[bootstrap] SMTP selector is not configured; skipping saas-smtp reconciliation"
      fi

      # --- Root app-of-apps: hand ongoing delivery to ArgoCD/Git ---
      kubectl -n argocd apply -f - <<EOF
      apiVersion: argoproj.io/v1alpha1
      kind: Application
      metadata:
        name: root
        namespace: argocd
      spec:
        project: default
        source:
          repoURL: $ARGOCD_REPO_URL
          targetRevision: $ARGOCD_REPO_REVISION
          path: $ARGOCD_REPO_PATH
        destination:
          server: https://kubernetes.default.svc
          namespace: argocd
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true
      EOF

      echo "[bootstrap] $(date -u) done"

runcmd:
  - [ bash, /opt/saas/bootstrap.sh ]
