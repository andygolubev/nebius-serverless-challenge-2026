#cloud-config
# Bootstraps the saas-server: k3s (single node) + ArgoCD, credentials from MysteryBox.
# k3s API (6443) and ArgoCD stay private; reach them via `ssh -L` (see design.md Decision 6).
users:
  - name: saas-server
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
packages:
  - curl
  - jq
  - ufw

write_files:
  # Idempotent bootstrap. Logs to /var/log/saas-bootstrap.log for debugging.
  - path: /opt/saas/bootstrap.sh
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      exec > >(tee -a /var/log/saas-bootstrap.log) 2>&1
      echo "[bootstrap] $(date -u) starting"

      GITHUB_SECRET_ID="${github_secret_id}"
      REGISTRY_SECRET_ID="${registry_secret_id}"
      USE_REGISTRY_PULL="${use_registry_pull}"
      ARGOCD_REPO_URL="${argocd_repo_url}"
      ARGOCD_REPO_PATH="${argocd_repo_path}"
      ARGOCD_REPO_REVISION="${argocd_repo_revision}"

      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

      # --- Host firewall (defense-in-depth; Nebius security group is the primary control) ---
      # Only 22/80/443 inbound. Allow k3s pod/service CIDRs so cluster networking works.
      ufw --force reset
      ufw default deny incoming
      ufw default allow outgoing
      ufw allow 22/tcp
      ufw allow 80/tcp
      ufw allow 443/tcp
      ufw allow from 10.42.0.0/16   # k3s pod CIDR
      ufw allow from 10.43.0.0/16   # k3s service CIDR
      ufw --force enable

      # --- k3s (idempotent: installer is safe to re-run) ---
      if ! command -v k3s >/dev/null 2>&1; then
        # --tls-san localhost lets a tunneled kubectl (ssh -L 6443) verify the API cert.
        curl -sfL https://get.k3s.io | \
          INSTALL_K3S_EXEC="server --tls-san localhost --write-kubeconfig-mode 0640" sh -
      fi

      echo "[bootstrap] waiting for node Ready"
      for i in $(seq 1 60); do
        if kubectl get nodes 2>/dev/null | grep -q " Ready"; then break; fi
        sleep 5
      done
      kubectl get nodes

      # --- Fetch secrets from MysteryBox using the VM service-account identity ---
      # NOTE: confirm the exact CLI verb against the installed nebius CLI version.
      # Expected shape: `nebius mysterybox v1 payload get --secret-id <id>` returning
      # a JSON payload with a `token` key. Adjust here if the CLI differs.
      if ! command -v nebius >/dev/null 2>&1; then
        curl -sSL https://storage.eu-north1.nebius.cloud/nebius-cli/install.sh | bash || true
        export PATH="$PATH:/root/.nebius/bin:/usr/local/bin"
      fi
      fetch_secret_key() {
        local secret_id="$1" key="$2"
        nebius mysterybox v1 payload get --secret-id "$secret_id" --format json \
          | jq -r --arg k "$key" '.payload[] | select(.key==$k) | .string_value // .value'
      }

      GITHUB_TOKEN="$(fetch_secret_key "$GITHUB_SECRET_ID" token)"
      if [ -z "$GITHUB_TOKEN" ] || [ "$GITHUB_TOKEN" = "null" ]; then
        echo "[bootstrap] ERROR: could not read GitHub token from MysteryBox" >&2
        exit 1
      fi

      # --- ArgoCD (private ClusterIP; access via ssh -L to the argocd-server service) ---
      kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
      kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml
      kubectl -n argocd rollout status deploy/argocd-server --timeout=300s || true

      # ArgoCD repository credential (private repo read) from the GitHub token.
      kubectl -n argocd apply -f - <<EOF
      apiVersion: v1
      kind: Secret
      metadata:
        name: saas-repo
        namespace: argocd
        labels:
          argocd.argoproj.io/secret-type: repository
      stringData:
        type: git
        url: $ARGOCD_REPO_URL
        password: $GITHUB_TOKEN
        username: git
      EOF

      # Optional registry imagePullSecret (only when node-identity pull is insufficient).
      if [ "$USE_REGISTRY_PULL" = "true" ] && [ -n "$REGISTRY_SECRET_ID" ]; then
        REG_USER="$(fetch_secret_key "$REGISTRY_SECRET_ID" username)"
        REG_PASS="$(fetch_secret_key "$REGISTRY_SECRET_ID" password)"
        REG_HOST="$(fetch_secret_key "$REGISTRY_SECRET_ID" registry)"
        kubectl create namespace saas --dry-run=client -o yaml | kubectl apply -f -
        kubectl -n saas create secret docker-registry nebius-registry \
          --docker-server="$REG_HOST" --docker-username="$REG_USER" \
          --docker-password="$REG_PASS" --dry-run=client -o yaml | kubectl apply -f -
      fi

      # --- Root app-of-apps: hand ongoing delivery to ArgoCD/Git ---
      kubectl -n argocd apply -f - <<EOF
      apiVersion: argoproj.io/v1alpha1
      kind: Application
      metadata:
        name: root
        namespace: argocd
      spec:
        project: default
        source:
          repoURL: $ARGOCD_REPO_URL
          targetRevision: $ARGOCD_REPO_REVISION
          path: $ARGOCD_REPO_PATH
        destination:
          server: https://kubernetes.default.svc
          namespace: argocd
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true
      EOF

      echo "[bootstrap] $(date -u) done"

runcmd:
  - [ bash, /opt/saas/bootstrap.sh ]
