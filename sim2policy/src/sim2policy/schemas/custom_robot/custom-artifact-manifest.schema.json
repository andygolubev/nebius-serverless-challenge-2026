{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sim2policy/custom-robot/artifact-manifest/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "checksums"],
  "properties": {
    "artifacts": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
      },
      "required": [
        "final_policy",
        "metrics_json",
        "report_md",
        "reward_curve",
        "video_final",
        "resolved_config",
        "runtime_versions",
        "policy_bundle",
        "bundle_manifest",
        "robot_xml",
        "normalized_setup"
      ]
    },
    "checksums": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size_bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}
        }
      },
      "required": [
        "final_policy",
        "metrics_json",
        "report_md",
        "reward_curve",
        "video_final",
        "resolved_config",
        "runtime_versions",
        "policy_bundle",
        "bundle_manifest",
        "robot_xml",
        "normalized_setup"
      ]
    }
  }
}
