  "$id": "sim2policy/custom-robot/resolved-job/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_kind", "backend", "profile", "robot", "setup", "preparation", "runtime", "adapter", "training"],
  "properties": {
    "schema_version": {"const": 1},
