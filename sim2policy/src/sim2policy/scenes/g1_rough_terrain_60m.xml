<!--
  Server-owned G1 rough-terrain scene.

  A copy of mujoco-playground 0.2.0
  `_src/locomotion/g1/xmls/scene_mjx_feetonly_rough_terrain.xml`, identical except
  for the `hfield` line. Upstream declares `file="assets/hfield.png" size="10 10 .05 1.0"`
  -- a finite 20 m x 20 m patch with no floor beyond it. The robot spawns dead centre,
  so the nearest edge is 10 m away, while a 1,000-step episode at 0.02 s commanded at
  0.8 m/s implies 16 m of travel. The acceptance gate was unreachable by any policy.

  This declares the field by `nrow`/`ncol` with no asset file; the data is filled at
  registration by tiling the upstream 256x256 asset 3x3, preserving the upstream
  7.8125 cm/cell resolution and 0.05 m elevation amplitude exactly. Per-step terrain
  difficulty is unchanged -- only the extent grows. See
  `sim2policy.g1_forward_env.register_g1_forward_environments`.

  Every other element below is upstream, unmodified.
-->
<mujoco model="g1 feet only rough terrain scene">
  <include file="g1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- https://polyhaven.com/a/rock_face -->
    <texture type="2d" name="groundplane" file="assets/rocky_texture.png"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance=".8"/>
    <hfield name="hfield" nrow="768" ncol="768" size="30 30 .05 1.0"/>
  </asset>

  <worldbody>
    <geom name="floor" type="hfield" hfield="hfield" material="groundplane"/>
  </worldbody>

  <include file="sensor.xml"/>

  <keyframe>
    <key name="home"
      qpos="
      0 0 0.83
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "
      ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
    <key name="knees_bent"
      qpos="
      0 0 0.8
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "
      ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
    "/>
  </keyframe>
</mujoco>
